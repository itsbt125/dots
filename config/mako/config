# Mako (notifications)

font=JetBrainsMono Nerd Font 12

background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
border-radius=10
border-size=2

padding=12
margin=8
width=380
height=100

icons=1
max-icon-size=48
icon-path=/usr/share/icons/Adwaita

default-timeout=5000
ignore-timeout=0

[urgency=low]
background-color=#1e1e2e
border-color=#6c7086

[urgency=normal]
background-color=#1e1e2e
border-color=#89b4fa

[urgency=critical]
background-color=#f38ba8
text-color=#1e1e2e
border-color=#f38ba8
default-timeout=0
